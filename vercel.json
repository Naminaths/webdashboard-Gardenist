{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=@gardenist/web",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/web package.json package-lock.json vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
